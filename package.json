{
  "name": "perch",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "biome check . && prettier --check \"**/*.{md,markdown,yaml,yml}\"",
    "format": "biome format --write . && prettier --write \"**/*.{md,markdown,yaml,yml}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}": "biome check --write --no-errors-on-unmatched",
    "*.{md,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  }
}
