# Committed template for .env, which is gitignored. Key names only, never values.
# Copy to .env and fill in. If you add a key here, tell the team: the SessionStart
# env-drift hook compares every teammate's .env against this file.
#
# No service is chosen yet. The stack gets decided and justified in docs/TRD.md;
# add the keys it needs here at the same time, each with a one-line comment saying
# what it is for and where to get one.

# GONKAROUTER
GONKA_API_KEY=
GONKA_BASE_URL_OPENAI=
GONKA_BASE_URL_ANTHROPIC=
GONKA_MODEL_FAST=
GONKA_MODEL_DEEP=
GONKA_MODEL_THIRD=

# TAVILY
TAVILY_API_KEY=

# GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=

# GCP
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=

# ACCOUNTS
PROTON_EMAIL=
PROTON_PASSWORD=
DRIBBBLE_EMAIL=
DRIBBBLE_PASSWORD=
AWWWARDS_EMAIL=
AWWWARDS_PASSWORD=