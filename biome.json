{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/.agents", "!**/.claude", "!docs/assets", "!docs/demo", "!docs/research", "!v1"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "rules": { "preset": "recommended" } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "none", "semicolons": "asNeeded" }
  }
}
